# ---- imagen configuration (copy to .env or ~/.imagen/.env) ----

# Where generated images are written (also served at http://host:port/images/)
IMAGEN_OUTPUT_DIR=~/.imagen/images
# Default model when a request doesn't specify one, e.g. gemini/gemini-nano-banana-2.1 or openai/gpt-image-2
IMAGEN_DEFAULT_MODEL=
# HTTP server bind address (used by `imagen serve`)
IMAGEN_HOST=127.0.0.1
IMAGEN_PORT=4747
# Public base URL advertised in the A2A agent card / image URLs (defaults to http://IMAGEN_HOST:IMAGEN_PORT)
IMAGEN_PUBLIC_URL=

# ---- Google Gemini (Nano Banana) ----
GEMINI_API_KEY=
# Force the classic generateContent API instead of the Interactions API (1/true)
GEMINI_USE_GENERATE_CONTENT=
# Optional Gemini-compatible base URL
GEMINI_BASE_URL=

# ---- OpenAI (gpt-image-2, gpt-image-1.5, ...) ----
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL
OPENAI_BASE_URL=

# ---- Azure AI Foundry ----
# Resource endpoint, e.g. https://my-resource.services.ai.azure.com
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
# Comma-separated deployment names. Append :bfl to force the Black Forest Labs route
# (auto-detected for FLUX.2-*), :openai to force the OpenAI-compatible Image API.
AZURE_FOUNDRY_DEPLOYMENTS=gpt-image-1.5,FLUX.2-pro,FLUX-1.1-pro
AZURE_FOUNDRY_API_VERSION=preview
